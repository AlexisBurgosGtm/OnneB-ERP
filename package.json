{
  "name": "OnneB_pos",
  "version": "1.0.0",
  "description": "SPA POS OnneB - vanilla JS, Socket.IO, MSSQL",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/bump-build.js",
    "icons": "node scripts/generate-icons.js",
    "watch:build": "node scripts/watch-build.js",
    "postinstall": "node scripts/generate-icons.js && node scripts/sync-vendor-xlsx.js",
    "stop": "node scripts/stop-server.js",
    "license:check": "node scripts/check-license-catalog.js",
    "seed:updater:nomina": "node scripts/seed-update-query-nomina-all.js",
    "seed:updater:lotes": "node scripts/seed-update-query-invsaldo-lote.js",
    "seed:updater:productos-usa-lotes": "node scripts/seed-update-query-productos-usa-lotes.js",
    "seed:updater:productos-lastupdate": "node scripts/seed-update-query-productos-lastupdate.js",
    "seed:updater:lotes-all": "npm run seed:updater:lotes && npm run seed:updater:productos-usa-lotes",
    "seed:updater:asistencia-almuerzo": "node scripts/seed-update-query-asistencia-almuerzo.js",
    "seed:updater:tipodoc-plantilla-impresion": "node scripts/seed-update-query-tipodoc-plantilla-impresion.js",
    "seed:updater:fel-frase-tipodoc-obs": "node scripts/seed-update-query-fel-frase-tipodoc-obs.js",
    "seed:updater:voz-login-estilo": "node scripts/seed-update-query-voz-login-estilo.js",
    "seed:updater:fel-adendas-perso": "node scripts/seed-update-query-fel-adendas-perso.js",
    "seed:updater:permite-modificar-descripcion-ventas": "node scripts/seed-update-query-permite-modificar-descripcion-ventas.js",
    "seed:updater:permite-mover-boton-finalizar-en-docs": "node scripts/seed-update-query-permite-mover-boton-finalizar-en-docs.js",
    "seed:updater:community-costo-promedio": "node scripts/seed-update-query-community-costo-promedio.js",
    "seed:updater:documentos-mesa-restaurante": "node scripts/seed-update-query-documentos-mesa-restaurante.js",
    "seed:updater:documentos-lat-long": "node scripts/seed-update-query-documentos-lat-long.js",
    "seed:updater:empresas-regimen-fel": "node scripts/seed-update-query-empresas-regimen-fel.js",
    "dist:client": "node scripts/dist-client.js",
    "test": "nodemon server.js"
  },
  "distClient": {
    "product": "OnneB",
    "exe": "OnneB-Server.exe",
    "serviceId": "OnneB-ERP",
    "serviceName": "OnneB ERP",
    "port": "6500"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "routes/**/*.js",
      "lib/**/*.js",
      "config/**/*.js",
      "node_modules/pdfkit/js/pdfkit.js",
      "node_modules/pdfkit/js/output.cjs",
      "node_modules/pdfkit/js/standard-fonts/**/*.cjs",
      "node_modules/pdfkit/js/standard-fonts/chunks/**/*.cjs",
      "node_modules/pdfkit/lib/**/*.js",
      "node_modules/pdfkit/lib/fs/**/*.js",
      "node_modules/pdfkit/lib/zlib/**/*.js",
      "node_modules/pdfkit/lib/stream/**/*.js",
      "node_modules/qrcode/**/*.js",
      "node_modules/pngjs/**/*.js",
      "node_modules/@whiskeysockets/baileys/lib/**/*.js",
      "node_modules/@whiskeysockets/baileys/WAProto/**/*.js",
      "node_modules/libsignal/**/*.js",
      "node_modules/curve25519-js/**/*.js",
      "node_modules/ws/**/*.js",
      "node_modules/axios/**/*.js",
      "node_modules/async-mutex/**/*.js",
      "node_modules/@hapi/**/*.js",
      "node_modules/@cacheable/**/*.js",
      "node_modules/cacheable/**/*.js",
      "node_modules/keyv/**/*.js",
      "node_modules/@keyv/**/*.js",
      "node_modules/protobufjs/**/*.js",
      "node_modules/@protobufjs/**/*.js",
      "node_modules/pino/**/*.js",
      "node_modules/pino-std-serializers/**/*.js",
      "node_modules/@pinojs/**/*.js",
      "node_modules/sonic-boom/**/*.js",
      "node_modules/on-exit-leak-free/**/*.js",
      "node_modules/thread-stream/**/*.js",
      "node_modules/atomic-sleep/**/*.js",
      "node_modules/quick-format-unescaped/**/*.js",
      "node_modules/safe-stable-stringify/**/*.js",
      "node_modules/long/**/*.js",
      "node_modules/tslib/**/*.js",
      "node_modules/debug/**/*.js",
      "node_modules/ms/**/*.js",
      "node_modules/follow-redirects/**/*.js",
      "node_modules/form-data/**/*.js",
      "node_modules/combined-stream/**/*.js",
      "node_modules/delayed-stream/**/*.js",
      "node_modules/asynckit/**/*.js",
      "node_modules/mime-types/**/*.js",
      "node_modules/mime-db/**/*.js",
      "node_modules/hasown/**/*.js",
      "node_modules/es-errors/**/*.js",
      "node_modules/es-set-tostringtag/**/*.js",
      "node_modules/es-define-property/**/*.js",
      "node_modules/es-object-atoms/**/*.js",
      "node_modules/get-intrinsic/**/*.js",
      "node_modules/get-proto/**/*.js",
      "node_modules/gopd/**/*.js",
      "node_modules/has-symbols/**/*.js",
      "node_modules/has-tostringtag/**/*.js",
      "node_modules/function-bind/**/*.js",
      "node_modules/call-bind-apply-helpers/**/*.js",
      "node_modules/dunder-proto/**/*.js",
      "node_modules/math-intrinsics/**/*.js",
      "node_modules/agent-base/**/*.js",
      "node_modules/https-proxy-agent/**/*.js",
      "node_modules/hashery/**/*.js",
      "node_modules/hookified/**/*.js",
      "node_modules/qified/**/*.js",
      "node_modules/has-flag/**/*.js",
      "node_modules/supports-color/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "config/**/*",
      "data/config-tipos-documento.json",
      "data/fel-adendas.json",
      "node_modules/pdfkit/js/data/**/*",
      "node_modules/@whiskeysockets/baileys/lib/**/*.json"
    ],
    "ignore": [
      "**/sharp/**",
      "**/open/xdg-open",
      "canvas"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist-client"
  },
  "keywords": [
    "pos",
    "spa",
    "vanilla"
  ],
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^11.0.0",
    "@whiskeysockets/baileys": "^6.7.22",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mssql": "^11.0.1",
    "multer": "^2.2.0",
    "parallax-js": "^3.1.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "webdav": "^5.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "nodemon": "^3.1.9",
    "pace-js": "^1.2.4",
    "sharp": "^0.35.1",
    "terser": "^5.50.0"
  }
}
